#!/bin/sh
# Fast gate (~3 s warm): formatting and lint only. Tests run on pre-push.
# Skips entirely when no Rust or manifest file is staged.

# Match per line. A `case` on the whole multi-line list only ever tests the
# last path, so staging a .rs file followed by a .md file skipped the gate.
if ! git diff --cached --name-only --diff-filter=ACMR \
  | grep -qE '(\.rs|Cargo\.toml|Cargo\.lock|rust-toolchain\.toml)$'; then
  echo "pre-commit: no Rust changes staged, skipping"
  exit 0
fi

start=$(date +%s)

if ! cargo fmt --all --check; then
  echo ""
  echo "pre-commit: formatting differs. Run 'cargo fmt --all' and stage the result."
  exit 1
fi

if ! cargo clippy --workspace --all-targets --all-features -- -D warnings; then
  echo ""
  echo "pre-commit: clippy reported problems. Fix them, or justify an explicit #[allow]."
  exit 1
fi

echo "pre-commit: fmt + clippy clean in $(( $(date +%s) - start ))s"
