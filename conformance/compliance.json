      ]
    },
    {
      "id": "key-file",
      "statement": "The unprotected 32-byte seed, the protected HIDE-KEY file and the signing seed load; a key file whose Argon2 parameters are outside the bounds is refused before it allocates.",
      "spec": "§9.2–§9.4",
      "vectors": [
        "recipient.test-secret",
        "identity.test-seed",
        "signer.test-seed",
        "rejections/argon2-memory.test-secret"
      ]
    },
    {
      "id": "recipient-public-key",
      "statement": "A 1216-byte recipient public key is accepted; a small-order or non-canonical X25519 component is refused. A 1984-byte verifying key file loads.",
