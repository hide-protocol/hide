{
  "compliance": "hide-conformance/1",
  "about": "What a HIDE 1 implementation must do to be called conformant, in machine-readable form. Verified by conformance/harness/run.mjs against the frozen vector set named below.",
  "spec": "spec/hide-1.md",
  "vectors": {
    "directory": "conformance/vectors",
    "manifest": "conformance/vectors/manifest.json",
    "format": "hide-vectors/1",
    "manifestSha256": "bdb5319aa873f1e593fed481b81091238b98f772de355b367614a6a778cd2df3",
    "counts": {
      "container": {
        "open": 10,
        "reject": 28
      },
      "detached-signature": {
        "open": 2,
        "reject": 0
      },
      "public-key": {
        "open": 4,
        "reject": 3
      },
      "key": {
        "open": 3,
        "reject": 1
      },
      "subsystem": {
        "open": 24,
        "reject": 9
      }
    },
    "total": 84,
    "defaultSecret": "recipient.test-secret",
    "frozen": "The vector files are frozen artifacts (docs/stability.md); the harness only reads them and writes nothing inside conformance/vectors."
  },
  "protocol": {
    "document": "conformance/README.md",
    "verbs": {
      "container": "open-container",
      "key": "load-key",
      "public-key": "load-public-key",
      "subsystem": "verify-subsystem"
    },
    "hashOnlyKinds": [
      "detached-signature"
    ],
    "placeholders": [
      "{verb}",
      "{input}",
      "{key}",
      "{out}",
      "{message}",
      "{vectors}"
    ],
    "exitCodes": {
      "0": "accepted",
      "2": "refused, malformed (§6.1)",
      "3": "refused, unsupported (§6.1)",
      "4": "refused, authentication (§6.1)",
      "5": "refused, no matching recipient (§6.1, the single non-recipient outcome)",
      "10": "this command does not implement {verb}; the vector is reported NOT CHECKED, never a pass",
      "other": "the command did not run; the harness reports a failure"
    }
  },
  "levels": [
    {
      "id": "container",
      "requires": [
        "container"
      ],
      "meaning": "Reads and refuses containers with the §6.1 class on each refusal. The minimum for an interoperable reader."
    },
    {
      "id": "container+credentials",
      "requires": [
        "container",
        "key",
        "public-key"
      ],
      "meaning": "Also opens key files and accepts or refuses recipient public keys. The level the reference `hide` CLI can be driven to today."
    },
    {
      "id": "full",
      "requires": [
        "container",
        "key",
        "public-key",
        "subsystem"
      ],
      "meaning": "Every vector in the manifest, run with --require-complete. This is what criterion 3 of docs/stability.md asks of an implementation maintained outside this repository."
    }
  ],
  "behaviours": [
    {
      "id": "unsigned-container",
      "statement": "A HIDE 1 unsigned container opens to exactly the recorded plaintext, including a newer minor (7) and one that carries ignorable header, metadata and stanza data the reader does not understand.",
      "spec": "§1–§5",
      "vectors": [
        "hello.hide",
        "empty.hide",
        "grease.hide",
        "grease-minor.hide"
      ]
    },
    {
      "id": "signed-container",
      "statement": "The SIGNED flag with the HIDE/1.0 transcript verifies, in the public and the confidential placement, and an unknown stanza or extension stays bound by the transcript.",
      "spec": "§7.1–§7.3",
      "vectors": [
        "v1-signed.hide",
        "v1-signed-confidential.hide",
        "grease-signed.hide"
      ]
    },
    {
      "id": "legacy-signed-container",
      "statement": "A minor-2 container still opens and reports its signer, publicly or confidentially.",
      "spec": "§7.4",
      "vectors": [
        "signed-public.hide",
        "signed-confidential.hide"
      ]
    },
    {
      "id": "seed-derived-recipient",
      "statement": "A container sealed to the recipient key derived from a 32-byte master seed opens with the seed.",
      "spec": "§9.1",
      "vectors": [
