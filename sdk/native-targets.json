    },
    {
      "target": "aarch64-pc-windows-msvc",
      "os": "windows-11-arm",
      "library": "hide_ffi.dll",
      "npm": "win32-arm64",
      "nodePlatform": "win32",
      "nodeArch": "arm64",
      "gem": "aarch64-mingw-ucrt",
      "rid": "win-arm64"
    },
    {
      "target": "aarch64-apple-darwin",
      "os": "macos-15",
      "library": "libhide_ffi.dylib",
      "npm": "darwin-arm64",
      "nodePlatform": "darwin",
      "nodeArch": "arm64",
      "gem": "arm64-darwin",
      "rid": "osx-arm64"
    },
    {
      "target": "x86_64-apple-darwin",
      "os": "macos-15",
      "library": "libhide_ffi.dylib",
      "npm": "darwin-x64",
