{
  "name": "hide-protocol",
  "version": "0.7.0",
  "description": "Experimental hybrid post-quantum file and message encryption (X25519 + ML-KEM-768). Unaudited.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "koffi": "3.2.1"
  },
  "optionalDependencies": {
    "@hide-protocol/darwin-arm64": "0.7.0",
    "@hide-protocol/darwin-x64": "0.7.0",
    "@hide-protocol/linux-arm64": "0.7.0",
    "@hide-protocol/linux-x64": "0.7.0",
    "@hide-protocol/linux-x64-musl": "0.7.0",
    "@hide-protocol/win32-arm64": "0.7.0",
    "@hide-protocol/win32-x64": "0.7.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  },
  "keywords": [
    "encryption",
    "post-quantum",
    "cryptography",
    "hpke",
    "ml-kem",
    "x25519",
    "pqc",
    "quantum-resistant",
    "file-encryption",
    "e2ee",
    "age"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hide-protocol/hide.git",
    "directory": "sdk/node"
  },
  "bugs": {
    "url": "https://github.com/hide-protocol/hide/issues"
  },
  "homepage": "https://github.com/hide-protocol/hide"
}
