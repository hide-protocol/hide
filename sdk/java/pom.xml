<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.hide-protocol</groupId>
  <artifactId>hide</artifactId>
  <version>0.7.0</version>
  <packaging>jar</packaging>

  <name>HIDE</name>
  <description>
    Experimental hybrid post-quantum file and message encryption
    (X25519 + ML-KEM-768). Unaudited: do not protect data you cannot afford to
    lose or expose.
  </description>
  <url>https://github.com/hide-protocol/hide</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>HIDE Protocol contributors</name>
      <url>https://github.com/hide-protocol</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/hide-protocol/hide</url>
    <connection>scm:git:https://github.com/hide-protocol/hide.git</connection>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The Foreign Function and Memory API is final in 22. -->
    <maven.compiler.release>22</maven.compiler.release>
  </properties>

  <!-- No <distributionManagement>: there is no Sonatype / Maven Central
       account for org.hide-protocol yet, so this POM cannot publish anywhere.
       Add the OSSRH/Central Portal repository here once the namespace is
       verified; the release profile below already attaches what Central
       requires (sources, javadoc, GPG signatures). -->

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- HideTest is a plain main() with no JUnit dependency, so surefire
               has nothing to discover and would fail on the empty result. The
               CI workflow runs it directly with -Dhide.library pointing at the
               freshly built native core. -->
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Signing needs a key on the release machine; keep it out of every
           ordinary build: mvn -Prelease deploy -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
